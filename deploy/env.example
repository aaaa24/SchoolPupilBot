# Образец файла /opt/schoolpupilbot/<экземпляр>/env — несекретной конфигурации экземпляра.
# В проде его собирает CD из секретов GitHub (см. .github/workflows/cd.yml),
# вручную он нужен только для запуска сервера без деплоя.
# Секреты здесь не хранятся: их подтягивает bootstrap.py из Lockbox
# (TELEGRAM_BOT_TOKEN, YOOKASSA_SECRET_KEY, AWS_SECRET_ACCESS_KEY, VK_ACCESS_TOKEN,
# WEBHOOK_SECRET_TOKEN, PROXY_SECRET). Значения секретов должны быть в ASCII:
# они уходят в HTTP-заголовки.

MESSENGERS=telegram
PORT=8080
WORKERS=2

LOCKBOX_SECRET_ID=your_lockbox_secret_id_here
YC_SERVICE_ACCOUNT_KEY_FILE=/etc/schoolpupilbot/authorized_key.json

YDB_MODE=cloud-local
YDB_DATABASE=/ru-central1/your-folder/your-database
YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135

LOG_MODE=local
LOG_INGEST=cloud
LOG_GROUP_ID=your_log_group_id_here
LOG_RESOURCE_ID=bot-server-prod

TELEGRAM_SUPERADMIN=your_admin_id_here
TELEGRAM_TECHNO_INFO=your_tech_chat_id_here
CHANNEL_PERVYE=your_channel_here

VK_APP_ID=your_vk_app_id_here
VK_DOMAIN=your_vk_group_domain_here

YOOKASSA_ACCOUNT_ID=your_account_id_here

AWS_ACCESS_KEY_ID=your_s3_access_key_id_here
AWS_REGION=ru-central1
S3_ENDPOINT_URL=https://storage.yandexcloud.net
BUCKET_NAME=your_bucket_name_here

CERT_PATH=/etc/letsencrypt/live/your_server_address/cert.pem
