# Какие мессенджеры обслуживает рантайм: telegram (сервер), max (Cloud Functions)
MESSENGERS=max

# YDB
YDB_MODE=cloud
YDB_DATABASE=/ru-central1/your-folder/your-database
YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135

# Логи
LOG_MODE=cloud
LOG_GROUP_ID=your_log_group_id_here
# Только вне облака: куда писать логи и под каким идентификатором ресурса
LOG_INGEST=cloud
LOG_RESOURCE_ID=bot-server-prod

# Telegram (сервер)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_SUPERADMIN=your_admin_id_here
TELEGRAM_TECHNO_INFO=your_tech_chat_id_here
CHANNEL_PERVYE=your_channel_here
WEBHOOK_SECRET_TOKEN=your_webhook_secret_here

# MAX (Cloud Functions)
MAX_BOT_TOKEN=your_max_bot_token_here
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_SUPERADMIN=your_max_admin_id_here
MAX_TECHNO_INFO=your_max_tech_chat_id_here

# Пересылка уведомлений об оплате из Cloud Functions на сервер.
# PROXY_SECRET нужен обоим рантаймам, значение только из ASCII
SERVER_WEBHOOK_URL=https://your_server_address
PROXY_SECRET=your_proxy_secret_here

# YooKassa
YOOKASSA_ACCOUNT_ID=your_account_id_here
YOOKASSA_SECRET_KEY=your_secret_key_here

# VK
VK_APP_ID=your_vk_app_id_here
VK_ACCESS_TOKEN=your_vk_access_token_here
VK_DOMAIN=your_vk_group_domain_here

# Объектное хранилище Yandex
AWS_ACCESS_KEY_ID=your_s3_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_s3_secret_access_key_here
AWS_REGION=ru-central1
S3_ENDPOINT_URL=https://storage.yandexcloud.net
BUCKET_NAME=your_bucket_name_here
